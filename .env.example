RAG_AGENT_ENVIRONMENT=development
RAG_AGENT_LOG_LEVEL=INFO
RAG_AGENT_DATA_DIR=data
RAG_AGENT_CHROMA_DIR=data/chroma
RAG_AGENT_SQLITE_PATH=data/rag_agent.sqlite3
RAG_AGENT_QWEN_API_KEY=
RAG_AGENT_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_AGENT_QWEN_CHAT_MODEL=qwen-plus
RAG_AGENT_QWEN_EMBEDDING_MODEL=text-embedding-v4
RAG_AGENT_MODEL_TIMEOUT_SECONDS=30
RAG_AGENT_MODEL_MAX_RETRIES=2
RAG_AGENT_RETRIEVAL_TOP_K=5
RAG_AGENT_RETRIEVAL_THRESHOLD=0.35
RAG_AGENT_CONVERSATION_WINDOW_SIZE=8
RAG_AGENT_CHECKPOINT_PATH=data/rag_agent.sqlite3
